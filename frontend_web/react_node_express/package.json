{
  "name": "sis-web-mvc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cy:open": "cypress open",
    "cy:run:system": "cypress run --spec 'cypress/e2e/system/**/*.cy.js'",
    "cy:run:acceptance": "cypress run --spec 'cypress/e2e/acceptance/**/*.cy.js'",
    "cy:clean-reports": "rimraf cypress/reports",
    "cy:run:all": "npm run cy:clean-reports && cypress run"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-jest": "^30.5.2",
    "cypress": "^15.21.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "vite": "^8.0.4"
  }
}
